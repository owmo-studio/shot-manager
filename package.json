{
    "name": "owmo-shot-manager",
    "version": "1.0.2",
    "private": true,
    "description": "A local desktop workspace for video processing",
    "main": "out/main/index.cjs",
    "scripts": {
        "postinstall": "install-electron",
        "dev": "electron-vite dev",
        "start": "electron-vite preview",
        "typecheck": "tsc --noEmit",
        "build": "npm run typecheck && electron-vite build && node scripts/copy-luts.cjs",
        "check:selection": "npm run build && node scripts/check-selection.cjs",
        "check:application": "node scripts/check-application-status.cjs",
        "check:configuration": "node scripts/check-configuration.cjs",
        "check:cache": "node scripts/check-cache-files.cjs",
        "check:communication": "node scripts/check-communication.cjs",
        "check:organization": "node scripts/check-organization.cjs",
        "check:workspace": "node scripts/check-workspace.cjs",
        "check:append": "node scripts/check-append.cjs",
        "check:eject": "node scripts/check-eject.cjs",
        "check:quit": "npm run build && node scripts/check-quit.cjs",
        "check:ingestion": "node scripts/check-ingestion.cjs",
        "check:library": "node scripts/check-library.cjs",
        "check:delete": "node scripts/check-delete.cjs",
        "check:catalogue": "node scripts/check-catalogue.cjs",
        "check:storage-recovery": "node scripts/check-storage-recovery.cjs",
        "check:sync": "node scripts/check-sync.cjs",
        "check:proxy-priority": "node scripts/check-proxy-priority.cjs",
        "check:proxies": "node scripts/check-proxies.cjs",
        "check:ingestion-ui": "npm run build && node scripts/check-ingestion-ui.cjs",
        "package": "npm run package:mac",
        "package:mac": "npm run build && node scripts/package-mac.cjs",
        "deploy": "npm run deploy:mac",
        "deploy:mac": "node scripts/deploy-mac.cjs",
        "check:deploy": "node scripts/check-deploy.cjs",
        "check:packaged": "node scripts/check-packaged.cjs"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "dependencies": {
        "fast-xml-parser": "^5.11.2",
        "fastify": "^5.12.7",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "electron": "^45.2.0",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.5"
    },
    "allowScripts": {
        "fsevents@2.3.3": true
    }
}
