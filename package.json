{
    "name": "shot-manager",
    "version": "1.3.1",
    "private": true,
    "license": "MIT",
    "description": "A local desktop workspace for video processing",
    "os": [
        "darwin"
    ],
    "main": "out/main/index.cjs",
    "scripts": {
        "postinstall": "install-electron",
        "dev": "electron-vite dev",
        "start": "electron-vite preview",
        "typecheck": "tsc --noEmit",
        "build": "npm run typecheck && electron-vite build",
        "test": "node tests/run.cjs",
        "test:ui": "npm run build && node tests/run.cjs --ui",
        "test:packaged": "node tests/packaged.cjs",
        "package": "npm run build && node scripts/package.cjs"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "dependencies": {
        "fast-xml-parser": "^5.12.1",
        "fastify": "^5.12.7",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "electron": "^45.2.0",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.5"
    },
    "allowScripts": {
        "fsevents@2.3.3": true
    }
}
