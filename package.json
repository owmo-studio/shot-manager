{
  "name": "owmo-shot-manager",
  "version": "0.1.0",
  "private": true,
  "description": "A local desktop workspace for video ingestion",
  "main": "out/main/index.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "check:selection": "npm run build && node scripts/check-selection.cjs",
    "check:configuration": "node scripts/check-configuration.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
